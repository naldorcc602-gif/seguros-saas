{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "lib": ["es2021"]
  },
  "include": ["apps/api/src"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
