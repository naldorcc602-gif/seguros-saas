# ── Banco de dados ──────────────────────────────────────────────
# Usado pelo container postgres do docker-compose:
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"
POSTGRES_DB="seguros_saas"
# Usado pela aplicação (api/workers). Em docker-compose.yml o host "postgres"
# já é resolvido automaticamente; para rodar fora do Docker, use "localhost".
DATABASE_URL="postgresql://postgres:troque-por-uma-senha-forte@localhost:5432/seguros_saas?schema=public"

# ── Redis (cache, filas BullMQ, refresh tokens) ─────────────────
REDIS_URL="redis://localhost:6379"

# ── Autenticação ─────────────────────────────────────────────────
JWT_ACCESS_SECRET="troque-por-um-segredo-forte"
# Reservado: o refresh token atual é um valor opaco (hash SHA-256 armazenado
# no banco, ver TokenService), não um JWT — este secret não é usado por
# enquanto, mas fica previsto caso a estratégia mude no futuro.
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_2FA_TEMP_SECRET="troque-por-um-terceiro-segredo-forte"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── Armazenamento de documentos (S3 ou Cloudflare R2) ───────────
STORAGE_PROVIDER="s3" # ou "r2"
STORAGE_BUCKET=""
# Dev local (sem custo): MinIO via docker-compose. Descomente/aponte:
#   STORAGE_ENDPOINT="http://localhost:9000"
#   STORAGE_ACCESS_KEY_ID="minioadmin"
#   STORAGE_SECRET_ACCESS_KEY="minioadmin"
# Produção S3 real: STORAGE_ENDPOINT="" (default da AWS).
# Produção R2: STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com".
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
# IMPORTANTE (produção, S3/R2): o navegador faz PUT direto ao bucket, então o
# bucket precisa de CORS permitindo PUT + header Content-Type da origem do web.
# O docker-compose já aplica essa regra ao MinIO local automaticamente.

# ── E-mail (SMTP) ────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="naoresponda@seudominio.com"

# ── WhatsApp Business API (Meta) — integração futura ────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── IA (resumos, pareceres, alertas) — Fase 11 ──────────────────────────
# Provedor de IA: deixe vazio para auto-detectar pela chave, ou force com
# "anthropic" (Claude) / "openai" (qualquer API compatível com /chat/completions).
AI_PROVIDER=""
# Opção A — Anthropic Claude:
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
# Opção B — OpenAI-compatible (OpenAI, DeepSeek, Ollama, LM Studio etc.):
#   * OpenAI:      OPENAI_BASE_URL="" (usa https://api.openai.com/v1)
#   * DeepSeek:    OPENAI_BASE_URL="https://api.deepseek.com"
#   * Ollama local: OPENAI_BASE_URL="http://localhost:11434/v1" (OPENAI_API_KEY pode ficar em branco)
#   * LM Studio:   OPENAI_BASE_URL="http://localhost:1234/v1" (OPENAI_API_KEY em branco)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_BASE_URL=""

# ── Aplicação ─────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="3001"
WEB_PORT="3000"
APP_BASE_URL="http://localhost:3000"
# URL pública da API (Nest). Em desenvolvimento o web usa o default
# http://localhost:3001, então pode deixar em branco se rodar tudo na máquina.
NEXT_PUBLIC_API_URL=""
# Em desenvolvimento o Swagger (/docs) sempre fica ligado, independente
# desta variável — ela só importa quando NODE_ENV=production (Fase 16).
SWAGGER_ENABLED="true"
