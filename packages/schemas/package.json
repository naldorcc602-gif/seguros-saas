  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.13",
    "typescript": "^5.6.0"
  }
}
