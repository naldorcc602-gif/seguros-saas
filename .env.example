# ── Banco de dados ──────────────────────────────────────────────
# Usado pelo container postgres do docker-compose:
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"
POSTGRES_DB="seguros_saas"
# Usado pela aplicação (api/workers). Em docker-compose.yml o host "postgres"
# já é resolvido automaticamente; para rodar fora do Docker, use "localhost".
DATABASE_URL="postgresql://postgres:troque-por-uma-senha-forte@localhost:5432/seguros_saas?schema=public"

# ── Redis (cache, filas BullMQ, refresh tokens) ─────────────────
REDIS_URL="redis://localhost:6379"

# ── Autenticação ─────────────────────────────────────────────────
JWT_ACCESS_SECRET="troque-por-um-segredo-forte"
# Reservado: o refresh token atual é um valor opaco (hash SHA-256 armazenado
# no banco, ver TokenService), não um JWT — este secret não é usado por
# enquanto, mas fica previsto caso a estratégia mude no futuro.
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_2FA_TEMP_SECRET="troque-por-um-terceiro-segredo-forte"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── Armazenamento de documentos (S3 ou Cloudflare R2) ───────────
STORAGE_PROVIDER="s3" # ou "r2"
STORAGE_BUCKET=""
STORAGE_REGION=""
# Deixe em branco para AWS S3 real. Para Cloudflare R2 ou outro compatível
# com S3, defina a URL do endpoint (ex: https://<account_id>.r2.cloudflarestorage.com).
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# ── E-mail (SMTP) ────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="naoresponda@seudominio.com"

# ── WhatsApp Business API (Meta) — integração futura ────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── IA (resumos, pareceres, alertas) — Fase 11 ──────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# ── Aplicação ─────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="3001"
WEB_PORT="3000"
APP_BASE_URL="http://localhost:3000"
# Em desenvolvimento o Swagger (/docs) sempre fica ligado, independente
# desta variável — ela só importa quando NODE_ENV=production (Fase 16).
SWAGGER_ENABLED="true"
