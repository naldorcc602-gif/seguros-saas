# .env.producao.example
#
# Copie para `.env` no servidor de produção e preencha os segredos reais.
# NUNCA reaproveite segredos de desenvolvimento/homologação aqui.

# ── Banco de dados ──────────────────────────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="GERE_UMA_SENHA_FORTE_UNICA_DE_PRODUCAO"
POSTGRES_DB="seguros_saas"
DATABASE_URL="postgresql://postgres:GERE_UMA_SENHA_FORTE_UNICA_DE_PRODUCAO@postgres:5432/seguros_saas?schema=public"

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── Autenticação ─────────────────────────────────────────────────
# openssl rand -base64 48 — três segredos DIFERENTES entre si e diferentes
# dos de homologação/desenvolvimento.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_2FA_TEMP_SECRET=""
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── Armazenamento ────────────────────────────────────────────────
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="seguros-saas-producao"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# ── E-mail (SMTP real — este ambiente manda e-mail de verdade) ──────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="naoresponda@seudominio.com"

# ── IA ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# ── Aplicação ─────────────────────────────────────────────────────
NODE_ENV="production"
APP_BASE_URL="https://seudominio.com"
PORT="3001"

# Swagger fica DESATIVADO por padrão em produção (ver main.ts, Fase 16).
# Só defina como "true" se precisar mesmo expor a documentação publicamente
# (ex: para parceiros de integração) — avalie o trade-off de exposição.
SWAGGER_ENABLED="false"

# ── SSL (usado por infra/scripts/init-ssl.sh, não pela aplicação em si) ──
DOMAIN="seudominio.com"
CERTBOT_EMAIL="admin@seudominio.com"

SMOKE_TEST_BASE_URL="https://seudominio.com"
