# .env.homologacao.example
#
# Copie para `.env` no servidor de homologação e preencha os segredos reais
# (nunca comite o .env de verdade). Diferenças em relação ao .env.example
# de desenvolvimento estão comentadas abaixo.

# ── Banco de dados ──────────────────────────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="GERE_UMA_SENHA_FORTE_AQUI"
POSTGRES_DB="seguros_saas_homolog"
# Em produção/homologação via docker-compose, o host "postgres" já resolve
# para o container — não precisa mudar para um IP.
DATABASE_URL="postgresql://postgres:GERE_UMA_SENHA_FORTE_AQUI@postgres:5432/seguros_saas_homolog?schema=public"

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── Autenticação ─────────────────────────────────────────────────
# GERE segredos novos e únicos para homologação — nunca reaproveite os de
# desenvolvimento nem os de produção. Sugestão: `openssl rand -base64 48`
JWT_ACCESS_SECRET="GERE_COM_openssl_rand_-base64_48"
JWT_REFRESH_SECRET="GERE_OUTRO_SEGREDO_DIFERENTE"
JWT_2FA_TEMP_SECRET="GERE_UM_TERCEIRO_SEGREDO_DIFERENTE"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── Armazenamento (recomendado: bucket separado do de produção) ──
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="seguros-saas-homolog"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# ── E-mail — use um serviço de teste (Mailtrap/Mailhog), NUNCA o SMTP ───
# de produção, para não mandar e-mail de verdade para clientes durante testes
# de homologação.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="homologacao@seudominio.com"

# ── IA — pode reaproveitar a mesma chave de produção (custo por uso, não por ambiente) ──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# ── Aplicação ─────────────────────────────────────────────────────
# NODE_ENV=production mesmo em homologação, de propósito: homologação deve
# rodar os mesmos builds otimizados que produção usará (Next.js standalone,
# NestJS sem reload) — "development" aqui mudaria o comportamento da
# aplicação, não é sobre qual ambiente/domínio é.
NODE_ENV="production"
APP_BASE_URL="https://homolog.seudominio.com"
# CORS e os links de e-mail/portal usam esta URL — confirme que bate com o
# domínio de homologação configurado no Nginx (Fase 15/16).

# Flag opcional, lida pelo smoke-test.sh via env do shell (não pela aplicação):
SMOKE_TEST_BASE_URL="https://homolog.seudominio.com"
