# infra/nginx/conf.d/production-ssl.conf.template
#
# Gerado a partir deste template pelo infra/scripts/init-ssl.sh, substituindo
# ${DOMAIN} pelo domínio real e sobrescrevendo default.conf. Não edite
# default.conf diretamente depois de rodar init-ssl.sh — edite este template
# e rode o script de novo, senão a próxima renovação de certificado ou
# redeploy perde suas mudanças manuais.

upstream web_upstream {
    server web:3000;
}

upstream api_upstream {
    server api:3001;
}

# Porta 80: só existe para o desafio ACME (renovação do certificado) e para
# redirecionar todo o resto para HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS — força HTTPS em visitas futuras mesmo se alguém digitar http://
    # Só ative depois de confirmar que o SSL está estável (é difícil de
    # reverter rápido: navegadores guardam isso por até 2 anos, "max-age").
    add_header Strict-Transport-Security "max-age=63072000" always;

    client_max_body_size 50M;

    # Cobre tanto as rotas REST (/api/auth/login, /api/claims, ...) quanto o
    # WebSocket do Socket.IO (o front-end conecta em `${API_URL}/realtime`,
    # que com NEXT_PUBLIC_API_URL=.../api vira /api/realtime — por isso os
    # headers de upgrade de conexão já ficam aqui, não precisa de um
    # location /realtime/ separado).
    location /api/ {
        proxy_pass http://api_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location /docs {
        proxy_pass http://api_upstream/docs;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
